{
  "name": "dsh-retry-policy",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "模型失败重试策略：接管 DSH 模型请求重试，自定义重试次数与等待时间策略（固定/线性/指数 + 抖动），并在设置页可视化配置，即时生效。",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/settings-overview.png",
    "README.md",
    "SPEC.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/policy.js && node --check lib/host.js && node --check lib/client.js",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "retry",
    "backoff",
    "retry-policy",
    "exponential-backoff",
    "rate-limit",
    "重试",
    "退避"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinxiqinghuan/dsh-retry-policy.git"
  },
  "homepage": "https://github.com/jinxiqinghuan/dsh-retry-policy#readme",
  "bugs": {
    "url": "https://github.com/jinxiqinghuan/dsh-retry-policy/issues"
  },
  "meta": {
    "title": "模型重试策略",
    "description": "接管模型请求失败重试：自定义重试次数（含无限重试）与等待时间策略（固定/线性/指数退避 + 抖动），设置页可视化配置，保存即生效。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
